          "t": "text",
          "v": " be last season's points. \"24 more than "
        },
        {
          "t": "math",
          "v": "\\tfrac{3}{4}"
        },
        {
          "t": "text",
          "v": " of last season's total equals this season's 276\" gives "
        },
        {
          "t": "math",
          "v": "\\frac{3}{4}k + 24 = 276"
        },
        {
          "t": "text",
          "v": "."
        },
        {
          "t": "br"
        },
        {
          "t": "text",
          "v": "2. subtract constant: "
        },
        {
          "t": "text",
          "v": "Subtract 24 from both sides: "
        },
        {
          "t": "math",
          "v": "\\frac{3}{4}k = 252"
        },
        {
          "t": "text",
          "v": "."
        },
        {
          "t": "br"
        },
        {
          "t": "text",
          "v": "3. divide coefficient: "
        },
        {
          "t": "text",
          "v": "Multiply both sides by the reciprocal "
        },
        {
          "t": "math",
          "v": "\\frac{4}{3}"
        },
        {
          "t": "text",
          "v": ": "
        },
        {
          "t": "math",
          "v": "k = 252 \\cdot \\frac{4}{3}"
        },
        {
          "t": "text",
          "v": "."
        },
        {
          "t": "br"
        },
        {
          "t": "text",
          "v": "4. isolate variable: "
        },
        {
          "t": "text",
          "v": "Compute "
        },
        {
          "t": "math",
          "v": "k = 336"
        },
        {
          "t": "text",
          "v": ". Check: "
        },
        {
          "t": "math",
          "v": "\\frac{3}{4}(336) + 24 = 252 + 24 = 276"
        },
        {
          "t": "text",
          "v": " ✓."
        },
        {
          "t": "br"
        }
