        {
          "t": "text",
          "v": ", so "
        },
        {
          "t": "math",
          "v": "x = 7"
        },
        {
          "t": "text",
          "v": ". From the second case, "
        },
        {
          "t": "math",
          "v": "2x = 2"
        },
        {
          "t": "text",
          "v": ", so "
        },
        {
          "t": "math",
          "v": "x = 1"
        },
        {
          "t": "text",
          "v": ". Since "
        },
        {
          "t": "math",
          "v": "a > b"
        },
        {
          "t": "text",
          "v": ", we have "
        },
        {
          "t": "math",
          "v": "a = 7"
        },
        {
          "t": "text",
          "v": " and "
        },
        {
          "t": "math",
          "v": "b = 1"
        },
        {
          "t": "text",
          "v": ". Therefore "
        },
        {
          "t": "math",
          "v": "a - b = 7 - 1 = 6"
        },
        {
          "t": "text",
          "v": "."
        }
