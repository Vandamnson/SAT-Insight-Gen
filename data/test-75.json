    {
      "id": 8,
      "program": "SAT",
      "domain": "advanced_math",
      "band": "B7",
      "target_band": "B7",
      "statementId": "ADV.B7.s1",
      "skill": "open_nonlinear_equations_systems_7",
      "type": "spr",
      "stem": [
        {
          "t": "text",
          "v": "The equation "
        },
        {
          "t": "math",
          "v": "3^{x} + 3^{\\,2-x} = c"
        },
        {
          "t": "text",
          "v": ", where "
        },
        {
          "t": "math",
          "v": "c"
        },
        {
          "t": "text",
          "v": " is a constant, has exactly one real solution. What is the value of "
        },
        {
          "t": "math",
          "v": "c"
        },
        {
          "t": "text",
          "v": "?"
        }
      ],
      "solution": [
        {
          "t": "text",
          "v": "Rewrite the second term using exponent rules: "
        },
        {
          "t": "math",
          "v": "3^{2-x} = \\dfrac{9}{3^{x}}"
        },
        {
          "t": "text",
          "v": ". Let "
        },
        {
          "t": "math",
          "v": "u = 3^{x}"
        },
        {
          "t": "text",
          "v": ", so "
        },
        {
          "t": "math",
          "v": "u > 0"
        },
        {
          "t": "text",
          "v": ". The equation becomes "
        },
        {
          "t": "mathblock",
          "v": "u + \\dfrac{9}{u} = c \\quad\\Longrightarrow\\quad u^{2} - cu + 9 = 0."
        },
        {
          "t": "text",
          "v": "The product of the roots equals "
        },
        {
          "t": "math",
          "v": "9 > 0"
        },
        {
          "t": "text",
          "v": ", so both roots have the same sign, and each positive value of "
        },
        {
          "t": "math",
          "v": "u"
        },
        {
          "t": "text",
          "v": " produces exactly one "
        },
        {
          "t": "math",
          "v": "x"
        },
        {
          "t": "text",
          "v": ". Hence the original equation has exactly one real solution only when "
        },
        {
          "t": "math",
          "v": "u^{2} - cu + 9 = 0"
        },
        {
          "t": "text",
          "v": " has a single (repeated) positive root. Set the discriminant to zero: "
        },
        {
          "t": "mathblock",
          "v": "c^{2} - 36 = 0 \\quad\\Longrightarrow\\quad c = 6 \\ \\text{or}\\ c = -6."
        },
        {
          "t": "text",
          "v": "If "
        },
        {
          "t": "math",
          "v": "c = -6"
        },
        {
          "t": "text",
          "v": ", the repeated root is "
        },
        {
          "t": "math",
          "v": "u = -3 < 0"
        },
        {
          "t": "text",
          "v": ", impossible since "
        },
        {
          "t": "math",
          "v": "u = 3^{x} > 0"
        },
        {
          "t": "text",
          "v": ". So "
        },
        {
          "t": "math",
          "v": "c = 6"
        },
        {
          "t": "text",
          "v": ", giving "
        },
        {
          "t": "math",
          "v": "(u-3)^{2} = 0"
        },
        {
          "t": "text",
          "v": ", "
        },
        {
          "t": "math",
          "v": "3^{x} = 3"
        },
        {
          "t": "text",
          "v": ", and the unique solution "
        },
        {
          "t": "math",
          "v": "x = 1"
        },
        {
          "t": "text",
          "v": ". Therefore "
        },
        {
          "t": "math",
          "v": "c = 6"
        },
        {
          "t": "text",
          "v": "."
        }
      ],
      "answer": {
        "accept": [
          "6"
        ],
