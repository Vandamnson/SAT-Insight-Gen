      "stem": [
        {
          "t": "text",
          "v": "A school fundraiser collects donations in tiers. Each tier raises $3, and the fundraiser raised a total of $15 across all tiers. The equation 3h = 15 models this situation, where h is the number of tiers that raised donations. What is the value of h?"
        }
      ],
      "options": [
        {
          "key": "A",
          "seg": [
            {
              "t": "text",
              "v": "12"
            }
          ]
        },
        {
          "key": "B",
          "seg": [
            {
