          "t": "text",
          "v": "At a craft brewery, each batch of beer contains h gallons. A brewer records that the total volume produced across 9 batches is equal to 40 gallons more than the volume of a single batch. What is the value of h?"
        }
      ],
      "options": [
        {
          "key": "A",
          "seg": [
            {
              "t": "text",
              "v": "4"
            }
          ]
        },
        {
          "key": "B",
          "seg": [
