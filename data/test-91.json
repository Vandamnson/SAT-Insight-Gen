              "v": "18"
            }
          ]
        },
        {
          "key": "D",
          "seg": [
            {
              "t": "text",
              "v": "45"
            }
          ]
        }
      ],
      "answer": {
        "correct": "B"
      },
      "solution": [
        {
          "t": "text",
          "v": "1. isolate variable: Read the context: h tiers each raising $3 yields a total of $15, giving the equation 3h = 15. The variable h is multiplied by the coefficient 3."
        },
        {
          "t": "br"
        },
        {
          "t": "text",
          "v": "2. divide coefficient: Divide both sides of 3h = 15 by 3: h = 15 ÷ 3 = 5."
        },
        {
          "t": "br"
        }
      ],
