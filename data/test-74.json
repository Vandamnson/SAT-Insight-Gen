      ],
      "solution": [
        {
          "t": "text",
          "v": "Factor the quadratic by splitting the middle term. Find two numbers whose product is "
        },
        {
          "t": "math",
          "v": "a\\cdot c = (2)(-15) = -30"
        },
        {
          "t": "text",
          "v": " and whose sum is "
        },
        {
          "t": "math",
          "v": "b = 1"
