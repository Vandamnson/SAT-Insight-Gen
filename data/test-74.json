        },
        {
          "t": "text",
          "v": "?"
        }
      ],
      "solution": [
        {
          "t": "text",
          "v": "Since the radical is already isolated, square both sides to undo the square root: "
        },
        {
          "t": "math",
          "v": "(\\sqrt{2x+7})^2=5^2"
        },
        {
          "t": "text",
          "v": ", which gives "
        },
        {
          "t": "math",
          "v": "2x+7=25"
        },
        {
          "t": "text",
          "v": ". Subtract "
        },
        {
          "t": "math",
          "v": "7"
        },
        {
          "t": "text",
          "v": " from both sides to get "
        },
        {
          "t": "math",
          "v": "2x=18"
        },
        {
          "t": "text",
          "v": ". Divide both sides by "
        },
        {
          "t": "math",
          "v": "2"
        },
        {
          "t": "text",
          "v": " to find "
        },
        {
          "t": "math",
          "v": "x=9"
        },
        {
          "t": "text",
          "v": ". Check: "
        },
        {
          "t": "math",
          "v": "\\sqrt{2(9)+7}=\\sqrt{25}=5"
        },
        {
          "t": "text",
          "v": ", so the solution is valid."
        }
      ],
      "answer": {
        "accept": [
          "9"
        ],
