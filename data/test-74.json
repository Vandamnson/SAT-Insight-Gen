      "stem": [
        {
          "t": "text",
          "v": "The given equation has two solutions."
        },
        {
          "t": "mathblock",
          "v": "2(x-3)(x+5)=0"
        },
        {
          "t": "text",
          "v": "What is the greater of the two solutions to the given equation?"
        }
      ],
      "solution": [
        {
          "t": "text",
          "v": "By the zero-product property, the product equals 0 only when one of the factors equals 0, so set each factor equal to 0."
        },
        {
          "t": "mathblock",
          "v": "x-3=0 \\;\\Rightarrow\\; x=3"
        },
        {
          "t": "mathblock",
          "v": "x+5=0 \\;\\Rightarrow\\; x=-5"
        },
        {
          "t": "text",
          "v": "The constant factor "
        },
        {
          "t": "math",
          "v": "2"
        },
        {
          "t": "text",
          "v": " cannot be 0, so the two solutions are "
        },
        {
          "t": "math",
          "v": "x=3"
        },
        {
          "t": "text",
          "v": " and "
        },
        {
          "t": "math",
          "v": "x=-5"
        },
        {
          "t": "text",
          "v": ". The greater of these is "
        },
        {
          "t": "math",
          "v": "3"
        },
        {
          "t": "text",
          "v": "."
        }
      ],
      "answer": {
