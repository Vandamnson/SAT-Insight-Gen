          "v": "6"
        },
        {
          "t": "text",
          "v": " and "
        },
        {
          "t": "math",
          "v": "-5"
        },
        {
          "t": "text",
          "v": ", so rewrite and group:"
        },
        {
          "t": "mathblock",
          "v": "2x^2 + 6x - 5x - 15 = 0"
        },
        {
          "t": "mathblock",
          "v": "2x(x+3) - 5(x+3) = 0"
        },
        {
          "t": "mathblock",
          "v": "(2x-5)(x+3) = 0"
        },
        {
          "t": "text",
          "v": "Set each factor equal to "
        },
        {
          "t": "math",
          "v": "0"
        },
        {
          "t": "text",
          "v": ". From "
        },
        {
          "t": "math",
          "v": "2x-5=0"
        },
        {
          "t": "text",
          "v": " we get "
        },
        {
          "t": "math",
          "v": "x=\\tfrac{5}{2}"
        },
        {
          "t": "text",
          "v": ", and from "
        },
        {
          "t": "math",
          "v": "x+3=0"
        },
        {
          "t": "text",
          "v": " we get "
        },
        {
          "t": "math",
          "v": "x=-3"
        },
        {
          "t": "text",
          "v": ". The positive solution is "
        },
        {
          "t": "math",
          "v": "x=\\tfrac{5}{2}"
        },
        {
          "t": "text",
          "v": " (equivalently "
        },
        {
          "t": "math",
          "v": "2.5"
        },
        {
          "t": "text",
          "v": ")."
        }
      ],
