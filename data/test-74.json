      "type": "spr",
      "stem": [
        {
          "t": "text",
          "v": "For a constant "
        },
        {
          "t": "math",
          "v": "k"
        },
        {
          "t": "text",
          "v": ", the equation"
        },
        {
          "t": "mathblock",
          "v": "\\frac{k}{x+1}+\\frac{3}{x-2}=\\frac{20}{x^2-x-2}"
        },
        {
          "t": "text",
          "v": "has a solution "
        },
        {
          "t": "math",
          "v": "x=4"
        },
        {
          "t": "text",
          "v": ". What is the value of "
        },
        {
          "t": "math",
          "v": "k"
        },
        {
          "t": "text",
          "v": "?"
        }
      ],
      "solution": [
        {
          "t": "text",
          "v": "Factor the quadratic denominator using structure: "
        },
        {
          "t": "math",
          "v": "x^2-x-2=(x-2)(x+1)"
        },
        {
          "t": "text",
          "v": ", so every term shares the factors "
        },
        {
          "t": "math",
          "v": "(x+1)"
        },
        {
          "t": "text",
          "v": " and "
        },
        {
          "t": "math",
          "v": "(x-2)"
        },
        {
          "t": "text",
          "v": ". Multiply both sides by "
        },
        {
          "t": "math",
          "v": "(x+1)(x-2)"
        },
        {
          "t": "text",
          "v": " to clear all denominators:"
        },
        {
          "t": "mathblock",
          "v": "k(x-2)+3(x+1)=20"
        },
        {
          "t": "text",
          "v": "Because "
        },
        {
          "t": "math",
          "v": "x=4"
        },
        {
          "t": "text",
          "v": " is a solution, substitute it: "
        },
        {
          "t": "math",
          "v": "k(4-2)+3(4+1)=20"
        },
        {
          "t": "text",
          "v": ", which simplifies to "
        },
        {
          "t": "math",
          "v": "2k+15=20"
        },
        {
          "t": "text",
          "v": ". Subtract to get "
        },
        {
          "t": "math",
          "v": "2k=5"
        },
        {
          "t": "text",
          "v": ", so "
        },
        {
          "t": "math",
          "v": "k=\\tfrac{5}{2}=2.5"
        },
        {
          "t": "text",
          "v": "."
        }
