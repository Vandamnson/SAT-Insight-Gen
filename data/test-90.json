            }
          ]
        }
      ],
      "answer": {
        "correct": "B"
      },
      "solution": [
        {
          "t": "text",
          "v": "1. subtract constant: Subtract 9 from both sides: 7w + 9 − 9 = 37 − 9, yielding 7w = 28."
        },
        {
          "t": "br"
        },
        {
          "t": "text",
          "v": "2. divide coefficient: Divide both sides by 7: w = 28 ÷ 7 = 4."
        },
        {
          "t": "br"
        }
